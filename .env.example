# Copy this file to .env and add your key from https://console.groq.com/keys
GROQ_API_KEY=your-groq-api-key-here
# Cerebras key (needed for LLM_PROVIDER=cerebras and the Stage 3 gpt-oss-120b benchmark): https://cloud.cerebras.ai
CEREBRAS_API_KEY=your-cerebras-api-key-here

# Optional: which LLM the app uses. Defaults: groq, with openai/gpt-oss-20b on Groq and gpt-oss-120b on Cerebras.
# LLM_PROVIDER=groq
# LLM_MODEL=openai/gpt-oss-20b
