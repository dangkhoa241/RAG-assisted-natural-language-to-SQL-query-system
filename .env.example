# Copy this file to .env and fill in what you use. Every setting is optional; see "Running the app" in the README.

# Groq key (the default provider): https://console.groq.com/keys
GROQ_API_KEY=your-groq-api-key-here
# Cerebras key, needed only for LLM_PROVIDER=cerebras and the Stage 3 gpt-oss-120b benchmark: https://cloud.cerebras.ai
CEREBRAS_API_KEY=your-cerebras-api-key-here

# Which LLM answers. Defaults: openai/gpt-oss-120b on Groq, falling back to openai/gpt-oss-20b on Groq
# (a separate quota) when the 120b's quota runs out or it is rate-limited, then to the rule-based generator.
# On Cerebras the default is gpt-oss-120b with no fallback model. Set LLM_FALLBACK_MODELS= (empty) to disable.
# LLM_PROVIDER=groq
# LLM_MODEL=openai/gpt-oss-120b
# LLM_FALLBACK_MODELS=openai/gpt-oss-20b

# The BERT intent model: a local folder (default intent_model/) or a Hugging Face Hub repo id.
# INTENT_MODEL_PATH=your-username/nl2sql-intent-model
