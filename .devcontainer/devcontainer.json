{
  "name": "NL to SQL (FastAPI + React)",
  // Or use a Dockerfile or Docker Compose file. More info: https://containers.dev/guide/dockerfile
  "image": "mcr.microsoft.com/devcontainers/python:1-3.11-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/node:1": { "version": "22" }
  },
  "customizations": {
    "codespaces": {
      "openFiles": [
        "README.md",
        "backend/main.py"
      ]
    },
    "vscode": {
      "settings": {},
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance"
      ]
    }
  },
  "updateContentCommand": "pip3 install --user -r requirements.txt -r backend/requirements.txt && (cd frontend && npm install) && echo '✅ Packages installed and Requirements met'",
  "postAttachCommand": {
    "backend": "uvicorn backend.main:create_app --factory --port 8000",
    "frontend": "cd frontend && npm run dev -- --host"
  },
  "portsAttributes": {
    "5173": {
      "label": "Application",
      "onAutoForward": "openPreview"
    },
    "8000": {
      "label": "API"
    }
  },
  "forwardPorts": [
    5173,
    8000
  ]
}
